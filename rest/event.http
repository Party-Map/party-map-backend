### Get All events
GET http://localhost:8080/api/events

> {%
    client.test("Request executed successfully", function () {
        client.assert(response.status === 200, "Response status is not 200");
    });
    client.test("Request returns the right number of events", function () {
        const len = jsonPath(response.body, "$.length()");
        client.assert(len === 12, "Expected 12 events");
    });
%}

### Get All upcoming events
GET http://localhost:8080/api/events/upcoming-events

> {%
    client.test("Request executed successfully", function () {
        client.assert(response.status === 200, "Response status is not 200");
    });
    client.test("Request returns the right number of events", function () {
        const len = jsonPath(response.body, "$.length()");
        client.assert(len === 11, "Expected 11 events");
    });
%}

### Get events by Placeid
