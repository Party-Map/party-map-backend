### Get search hit for "Balaton"
GET http://localhost:8080/api/search?q=Balaton
Accept: application/json

> {%
    client.test("Request executed successfully", function () {
        client.assert(response.status === 200, "Response status is not 200");
    });

    client.test("Request returns the right number of hits", function () {
        const len = jsonPath(response.body, "$.hits.length()");
        client.assert(len === 5, "Expected 5 hits");
    });

    client.test("Contains an EVENT", function () {
        const types = jsonPath(response.body, "$.hits[*].type");
        client.assert(types.includes("EVENT"), "Expected an EVENT hit");
    });

    client.test("Contains a PERFORMER", function () {
        const types = jsonPath(response.body, "$.hits[*].type");
        client.assert(types.includes("PERFORMER"), "Expected a PERFORMER hit");
    });

    client.test("Contains a PLACE", function () {
        const types = jsonPath(response.body, "$.hits[*].type");
        client.assert(types.includes("PLACE"), "Expected a PLACE hit");
    });
%}

