### Get search hit for ""
GET http://localhost:8080/api/search?q=
Accept: application/json

> {%
    client.test("Request executed successfully", function () {
        client.assert(response.status === 200, "Response status is not 200");
    });

    client.test("Request returns zero hits", function () {
        const len = jsonPath(response.body, "$.hits.length()");
        client.assert(len === 0, "Expected 0 hits");
    });
%}

### Get search hit for "DROP DATABASE partymap;"
GET http://localhost:8080/api/search?q=DROP%20DATABASE%20partymap%3B
Accept: application/json

> {%
    client.test("Request executed successfully", function () {
        client.assert(response.status === 200, "Response status is not 200");
    });

    client.test("Request returns zero hits, expected to not drop the database", function () {
        const len = jsonPath(response.body, "$.hits.length()");
        client.assert(len === 0, "Expected 0 hits");
    });
%}